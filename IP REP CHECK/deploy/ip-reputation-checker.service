[Unit]
Description=IP Reputation Checker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ipchecker
Group=ipchecker
WorkingDirectory=/opt/ip-reputation-checker
EnvironmentFile=/etc/ip-reputation-checker/ip-reputation-checker.env
ExecStart=/usr/bin/node /opt/ip-reputation-checker/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ip-reputation-checker

[Install]
WantedBy=multi-user.target
